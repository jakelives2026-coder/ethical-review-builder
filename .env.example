# Neon PostgreSQL — get from https://console.neon.tech
DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require

# OpenAI — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-string

# Resend — get from https://resend.com/api-keys (required for password reset emails)
RESEND_API_KEY=re_your-key-here
# Verified sender domain in Resend — configure at https://resend.com/domains
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Public app URL used in reset email links
APP_URL=https://ethical-review-builder.vercel.app

# Stripe — get from https://dashboard.stripe.com/apikeys
# Use sk_test_* / pk_test_* for development, sk_live_* / pk_live_* for production
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

NODE_ENV=development
PORT=5000
